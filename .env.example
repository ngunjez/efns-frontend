# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets in them.

# Base URL of the platform API (Elixir/Phoenix). All endpoints in src/api/endpoints are relative to it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Request timeout for API calls, in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# true = answer every API call from the mock handlers in src/mocks (use until the endpoints land).
# Must be false in staging and production.
NEXT_PUBLIC_USE_MSW=true

# Minutes of inactivity before a staff screen locks (frame 83: 15 minutes).
NEXT_PUBLIC_IDLE_LOCK_MINUTES=15

# Name of the httpOnly session cookie the API sets on staff sign-in. Read by src/proxy.ts only.
SESSION_COOKIE_NAME=ash_session
